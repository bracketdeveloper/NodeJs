<!DOCTYPE html>
<html>
<head>
  <title>Product Page</title>

  <!-- Bootstrap CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

  <!-- Product Card -->
  <div class="card shadow-sm p-4">
    
    <!-- Product Name -->
    <h2 class="mb-3"><%= product.name  %> </h2>

    <!-- Price -->
    <h4 class="text-primary">Price: $<%= product.price  %> </h4>

    <!-- Stock -->
    <% if(product.lowStock){ %>
        <p class="text-danger fw-bold">Low Stock!</p>
        <% } %>  
    <!-- or -->
    <p class="text-success">In Stock</p>

  </div>

  <!-- Specs -->
  <div class="mt-4">
    <h4>Specifications</h4>
    <ul class="list-group">
        <% product.specs.forEach(spec=>{ %> 
      <li class="list-group-item"><%= spec %> </li>
      <% }) %> 
    </ul>
  </div>

  <!-- Related Products -->
  <div class="mt-5">
    <h4>Related Products</h4>

    <div class="row">
      <% product.related.forEach(rel=>{ %> 
      <div class="col-md-4">
        <div class="card p-3 mb-3">
          <h5><%= rel.name %> </h5>
          <p class="text-muted">$<%= rel.price %> </p>
        </div>
      </div>
      <% }) %> 
    </div>
  </div>

</div>

</body>
</html>