<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>

<body>
  <h1>Welcome to <%= store.storeName %> </h1>
  <h3>Location: <%= store.location %> </h3>
  <% if (store.categories.length>0) {%>
    <% store.categories.forEach(cat=>{ %>
        <h4><%= cat.name %> </h4>
        <table border="1px">
            <tr>
                <th>Model</th>
                <th>price</th>
                <th>Stock</th>
            </tr>
            <% cat.items.forEach(item=>{ %>
                <tr>
                    <td><%= item.model %></td>
                    <td><%= item.price %></td>
                    <td><%= item.stock>0 ? item.stock : "No Stock" %></td>
                </tr>
                <% }) %>  
        </table>
        <% }) %>  
  <% } %>
</body>

</html>