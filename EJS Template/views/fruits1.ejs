<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>

<body>
  <h1>Printing Fruits with ForEach Loop</h1>
  <ul>
    <% fruits.forEach(i=>{%>
        <li><%= i %></li>
    <% }) %>
  </ul>
</body>

</html>