<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register Form</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    main {
      flex: 1;
    }
  </style>
</head>

<body>

  <header class="p-3 bg-dark text-white">
    <div class="container text-center">
      <h1>Bracket Developer</h1>
    </div>
  </header>

  <main class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-6 text-center">
        <h2 class="mb-4">Register Form</h2>
        <form action="/register" method="POST" class="border p-4 rounded shadow-sm">
          <div class="mb-3 text-start">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" name="username" placeholder="e.g. username" required>
          </div>
          <div class="mb-3 mt-3 text-start">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="user@gmail.com" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Submit</button>
        </form>
    <% if(data){ %>
            <div id="profileCard" class="border p-4 rounded shadow-sm mt-4 text-start">

            <h5>User Details</h5>

            <p><strong>Username:</strong> <span id="outName"><%= data.username %> </span></p>

            <p><strong>Email:</strong> <span id="outCity"><%= data.email %> </span></p>

            </div>
        <% } %>
      </div>
    </div>
  </main>

  <footer class="py-3 bg-light border-top">
    <div class="container text-center text-muted">
      <p class="mb-0">&copy; 2026 Bracket Developer</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>