<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feedback</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    main {
      flex: 1;
    }
  </style>
</head>

<body>

  <header class="p-3 bg-dark text-white">
    <div class="container text-center">
      <h1>Bracket Developer</h1>
    </div>
  </header>

  <main class="container my-5">
    <div class="row justify-content-center">
      <div class="col-md-6 text-center">

        <h2 class="mb-4">Feedback Form</h2>

        <form method="post" action="/feedback" class="border p-4 rounded shadow-sm text-start">

          <div class="mb-3">
            <label class="form-label">Your Feedback</label>
            <textarea name="feedback" class="form-control" id="feedback" rows="4" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-100">Submit</button>

        </form>

        <% if(data){ %>
        <div id="result" class="border p-4 rounded shadow-sm mt-4 text-start">

          <h5>Submitted Feedback</h5>

          <p><strong>Feedback:</strong> <span id="resultFeedback"><%= data.feedback %> </span></p>

          <p><strong>Status:</strong> <span id="resultStatus"><%= data.status %> </span></p>

        </div>
        <% } else { %>

        <p class="text-muted mt-4">No feedback submitted yet</p>

        <% } %>

      </div>
    </div>
  </main>

  <footer class="py-3 bg-light border-top">
    <div class="container text-center text-muted">
      <p class="mb-0">&copy; 2026 Bracket Developer</p>
    </div>
  </footer>

</body>

</html>